# Smart Asset Environment Configuration
PORT=3000

# PostgreSQL Connection String
# Example local docker: postgresql://postgres:postgrespassword@localhost:5432/smart_asset
# Example Supabase / Neon: postgresql://user:pass@ep-cool-fog-123456.us-east-2.aws.neon.tech/smart_asset?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/smart_asset

# Force PostgreSQL mode (optional, defaults to true if DATABASE_URL is set)
USE_POSTGRES=true
